
# Local agent/runtime state
.worktrees/
.omx/
.codex/
.codegraph/

# IDE/editor metadata
.idea/
.vscode/
*.iml

# OS files
**/.DS_Store

# Local screenshots or temporary visual notes
/screenshots/

# Keep repository uploads focused on code and README only.
*.md
!README.md
!AGENTS.md
*.png
!promo-assets/showcase-overview.png
!promo-assets/showcase-positions.png
!promo-assets/showcase-performance.png
!promo-assets/showcase-trades.png
!promo-assets/showcase-market.png
!promo-assets/showcase-settings.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg

# Python caches and local environments
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.venv/
*.egg-info/

# Frontend dependencies and build output
node_modules/
frontend/dist/

# Local secrets and credentials
.env
.env.*
!.env.example

# User portfolio data and local databases
*.xml
*.csv
*.xlsx
*.xls
*.db
*.sqlite
ibkr-dashboard-imports/

# Logs and reports
*.log
coverage/
htmlcov/
.coverage

# Internal planning/review documents, not needed for normal startup or use
docs/

# Keep the full local suite out of release artifacts, but version the regression
# files that define the portfolio-AI/settings contracts changed by this project.
backend/tests/*
!backend/tests/test_portfolio_analysis_contracts.py
!backend/tests/test_v2_integrations.py
!backend/tests/test_settings_api.py
!backend/tests/test_settings_service.py
